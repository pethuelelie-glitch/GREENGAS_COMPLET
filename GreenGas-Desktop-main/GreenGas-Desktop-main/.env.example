# URL du backend Django (contient déjà /api/v1, sans barre finale)
VITE_API_URL=http://localhost:8000/api/v1

# mock = faux backend MSW (données de docs/reference/seed.json) ; reel = backend Django
VITE_API_MODE=mock

# Date de travail affichée et utilisée par les écrans (AAAA-MM-JJ).
# Elle doit être identique au réglage GREENGAS_DATE_TRAVAIL du backend.
# Sans valeur : 2026-09-12 en mode mock, la date du jour en mode reel.
VITE_DATE_DEMO=2026-09-12

# Intervalle de rafraîchissement des tableaux de bord, en millisecondes
VITE_RAFRAICHISSEMENT_MS=5000
